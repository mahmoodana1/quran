{"1":{"w":[["عصر","عَصْر","اسم مجرور، مذكر، الجذر (عصر)","عصر"]],"g":[[0,0,0,"وَالدَّهْرِ."],[0,0,3,"الدّهر أقسم به وقال الحسن: أحد طرفي النهار .والعرب تسمى الغداة والعشيّ بالعصرين. واليوم والليل : العصرين، والشتاء والصيف العصرين. وعن علي رضي الله عنه «ونوائب العصر» وقيل: أراد: وأهل العصر، وقيل: وربّ العصر."],[0,0,1,"(قسمٌ) بالدّهر أو عصر النّبوّة"]]},"2":{"w":[["","إِنّ","حرف نصب، من الحروف الناسخة (إنّ وأخواتها)","إن"],["أنس","إِنسان","اسم منصوب، مذكر، الجذر (أنس)","إنسان"],["","فِي","حرف جر","في"],["خسر","خُسْر","اسم مجرور، مذكر، نكرة، الجذر (خسر)","خسر"]],"g":[[1,1,0,"كُلَّ بَنِي آدَمَ."],[3,3,0,"خُسْرَانٍ، وَهَلَكَةٍ، وَنُقْصَانٍ."],[1,1,2,"اسم جنس"],[0,1,1,"جنـْـس الإنسان (جَوَاب القسم)"],[2,3,1,"خُسْران و نُـقصان و هَلـَـكة"]]},"3":{"w":[["","إِلّا","أداة استثناء","إلا"],["","الَّذِي","اسم موصول، جمع مذكر","الذي"],["أمن","آمَنَ","فعل ماضٍ، للغائبين، الجذر (أمن)، الوزن (أَفْعَلَ)","آمن"],["عمل","عَمِلَ","فعل ماضٍ، للغائبين، الجذر (عمل)، الوزن (فَعَلَ)","عمل"],["صلح","صالِحَة","اسم فاعل منصوب، جمع مؤنث، الجذر (صلح)، الوزن (فَعَلَ)","صالحة"],["وصي","تَواصَ","فعل ماضٍ، للغائبين، الجذر (وصي)، الوزن (تَفاعَلَ)","تواص"],["حقق","حَقّ","اسم مجرور، مذكر، الجذر (حقق)","حق"],["وصي","تَواصَ","فعل ماضٍ، للغائبين، الجذر (وصي)، الوزن (تَفاعَلَ)","تواص"],["صبر","صَبْر","اسم مجرور، مذكر، الجذر (صبر)","صبر"]],"g":[[6,6,0,"بِالخَيْرِ كُلِّهِ: اعْتِقَادًا، وَعَمَلًا."],[8,8,0,"عَلَى الطَّاعَةِ، وَعَنِ المَعْصِيَةِ، وَعَلَى أَقْدَارِ اللهِ المُؤْلِمَةِ."],[5,6,1,"بالخَـيْر كلـّه اعتِقادًا و عَمَلاً"],[7,8,1,"عَن المَعاصي و على الطّـاعات و البلاء"]]}}