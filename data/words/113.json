{"1":{"w":[["قول","قالَ","فعل أمر، للمخاطب، الجذر (قول)، الوزن (فَعَلَ)","قال"],["عوذ","عُذْ","فعل مضارع مرفوع، للمتكلم، الجذر (عوذ)، الوزن (فَعَلَ)","عذ"],["ربب","رَبّ","اسم مجرور، مذكر، الجذر (ربب)","رب"],["فلق","فَلَق","اسم مجرور، مذكر، الجذر (فلق)","فلق"]],"g":[[1,1,0,"أَعْتَصِمُ، وَأَلْتَجِئُ."],[3,3,0,"الصُّبْحِ."],[3,3,3,"الصّبح. ويقال: واد في جهنم."],[3,3,2,"اصبح وقيل واد في جهنم وقيل غطاءها"],[1,1,1,"أعْـتصِـمُ و أستجير"],[2,3,1,"بربّ الصّـبْح .أو الخَـلـْـق كلـّهمْ"]]},"2":{"w":[["","مِن","حرف جر","من"],["شرر","شَرّ","اسم مجرور، مذكر مفرد، الجذر (شرر)","شر"],["","ما","اسم موصول","ما"],["خلق","خَلَقَ","فعل ماضٍ، للغائب، الجذر (خلق)، الوزن (فَعَلَ)","خلق"]]},"3":{"w":[["","مِن","حرف جر","من"],["شرر","شَرّ","اسم مجرور، مذكر مفرد، الجذر (شرر)","شر"],["غسق","غاسِق","اسم فاعل مجرور، مذكر، نكرة، الجذر (غسق)، الوزن (فَعَلَ)","غاسق"],["","إِذا","ظرف زمان","إذا"],["وقب","وَقَبَ","فعل ماضٍ، للغائب، الجذر (وقب)، الوزن (فَعَلَ)","وقب"]],"g":[[2,2,0,"لَيْلٍ شَدِيدِ الظُّلْمَةِ."],[3,4,0,"إِذَا دَخَلَ ظَلَامُهُ، وَتَغَلْغَلَ."],[2,4,3,"يعني اللّيل إذا دخل في كلّ شيء.والغسق: الظّلمة. ويقال: الغاسق: القمر إذا كسف فاسودّ. إِذا وَقَبَ: إذا دخل في الكسوف."],[1,2,1,"شرّ الليل"],[4,4,1,"دَخَل ظلامه في كلّ شيء"]]},"4":{"w":[["","مِن","حرف جر","من"],["شرر","شَرّ","اسم مجرور، مذكر مفرد، الجذر (شرر)","شر"],["نفث","نَفّاثَة","اسم مجرور، جمع مؤنث، الجذر (نفث)","نفاثة"],["","فِي","حرف جر","في"],["عقد","عُقْدَة","اسم مجرور، جمع مذكر، الجذر (عقد)","عقدة"]],"g":[[2,4,0,"السَّاحِرَاتِ اللَّوَاتِي يَنْفُخْنَ بِلَا رِيقٍ فِي عُقَدِ الخَيْطِ؛ بِقَصْدِ السِّحْرِ، سَوَاءٌ كُنَّ نِسَاءً، أَوْ أنْفُسًا خَبِيثَةً."],[2,2,3,"السّواحر ينفثن إذا سحرن ورقين.11"],[2,2,2,"السواحر ينفثن أي ينفلن إذا سحرن ورقين"],[2,4,1,"النـِّساء السَّـواحِر يَـنـْـفُـثـْنَ في عُـقـَـد الخيْط حين يَسْحَرْنَ"]]},"5":{"w":[["","مِن","حرف جر","من"],["شرر","شَرّ","اسم مجرور، مذكر مفرد، الجذر (شرر)","شر"],["حسد","حاسِد","اسم فاعل مجرور، مذكر، نكرة، الجذر (حسد)، الوزن (فَعَلَ)","حاسد"],["","إِذا","ظرف زمان","إذا"],["حسد","حَس