{"1":{"w":[["ضحو","ضُحًى","اسم مجرور، مذكر، الجذر (ضحو)","ضحى"]],"g":[[0,0,0,"قَسَمٌ بِأَوَّلِ النَّهَارِ، أَوْ كُلِّهِ."]]},"2":{"w":[["ليل","لَيْل","اسم مجرور، مذكر، الجذر (ليل)","ليل"],["","إِذا","ظرف زمان","إذا"],["سجو","سَجَى","فعل ماضٍ، للغائب، الجذر (سجو)، الوزن (فَعَلَ)","سجى"]],"g":[[2,2,0,"غَطَّى الكَوْنَ بِظَلَامِهِ، وَسَكَنَ."],[2,2,3,"سكن واستوت ظلمته، ومنه: بحر ساج وطرف ساج، أي ساكن."],[2,2,2,"ظلم"],[2,2,1,"سَكنَ أو اشتدّ ظلامه"]]},"3":{"w":[["","ما","حرف نفي","ما"],["ودع","وَدَّعَ","فعل ماضٍ، للغائب، الجذر (ودع)، الوزن (فَعَّلَ)","ودع"],["ربب","رَبّ","اسم مرفوع، مذكر، الجذر (ربب)","رب"],["","ما","حرف نفي","ما"],["قلي","قَلَى","فعل ماضٍ، للغائب، الجذر (قلي)، الوزن (فَعَلَ)","قلى"]],"g":[[0,1,0,"مَا تَرَكَكَ."],[3,4,0,"مَا أَبْغَضَكَ عِنْدَمَا أَبْطَأَ عَلَيْكَ الوَحْيَ."],[1,1,3,"تركك، ومنه قولهم: أستودعك الله غير مودّع، أي غير متروك. وبهذا سمّي الوداع لأنه فراق ومفارقة ."],[4,4,3,"أبغض ."],[4,4,2,"أبغض ونزلت لما انقطع الوحي عنه مرة"],[0,2,1,"ما تـَـرَك منـْـذ اختارَك (جواب القسم)"],[3,4,1,"ما أبْغَـضَـك منذ ُ أحبّـك"]]},"4":{"w":[["أخر","آخِر","اسم مرفوع، مؤنث مفرد، الجذر (أخر)","آخر"],["خير","خَيْر","اسم مرفوع، مذكر مفرد، نكرة، الجذر (خير)","خير"],["","","ضمير منفصل، للمخاطب",""],["","مِن","حرف جر","من"],["أول","أَوَّل","اسم مجرور، مؤنث، الجذر (أول)","أول"]]},"5":{"w":[["","سَوْف","حرف استقبال","سوف"],["عطو","أَعْطَى","فعل مضارع مرفوع، للغائب، الجذر (عطو)، الوزن (أَفْعَلَ)","أعطى"],["ربب","رَبّ","اسم مرفوع، مذكر، الجذر (ربب)","رب"],["رضو","رَضِيَ","فعل مضارع مرفوع، للمخاطب، الجذر (رضو)، الوزن (فَعَلَ)","رضي"]]},"6":{"w":[["","لَم","حرف نفي","لم"],["وجد","وَجَدَ","فعل مضارع مجزوم، للغائب، الجذر (وجد)، الوزن (فَعَلَ)","وجد"],["يتم","يَتِيم","اسم منصوب، مذكر مفرد، نكرة، الجذر (يتم)","يتيم"],["أوي","آوَى","فعل ماضٍ، للغائب، الجذر (أوي)، الوزن (أَفْعَلَ)","آوى"]],"g":[[3,3,0,"فَآوَاكَ، وَرَعَاكَ."],[0,1,1,"ألمْ يَعْـلمْـك ربّـكَ – قَدْ عَـلِـمَك . ."],[2,2,1,"طِفلاً مات أبوك و أنتَ جنين"],[3,3,1,"فَـضمّـك إلى مَنْ يَكفـلك و يَرْعاك"]]},"7":{"w":[["وجد","و