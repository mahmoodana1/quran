بد الله بن موهبة بن منقد بن نصر بن الحكم","k":3,"rk":"ثقة عابد مخضرم","tb":2,"n":3,"d":"61","ns":"الثوري،الكوفي","iq":"الكوفة","q":[["ابن حجر العسقلاني","قال في التقريب ثقة عابد مخضرم"],["الذهبي","حجة ورع قانت مخبت رباني"],["يحيى بن معين","لا يسأل عن مثله"],["أحمد بن عبد الله العجلي","ثقة وكان خيارا"],["أبو حاتم بن حبان البستي","ذكره في الثقات"],["عامر بن شراحيل الشعبي","من معادن الصدق ومرة كان الربيع أشد أصحاب ابن مسعود ورعا"]],"qn":6,"te":[[5079,"عبد الله بن مسعود",4,1],[6207,"عمرو بن ميمون الأودي",2,3],[30002,"موضع ارسال",1,12]],"ten":3,"st":[[4099,"عامر الشعبي",3,3],[8090,"هلال بن يساف الأشجعي",3,3],[1699,"المنذر بن يعلى الثوري",1,3]],"stn":3},"5629":{"s":"عطاء بن السائب الثقفي","f":"عطاء بن السائب بن مالك بن زيد","k":4,"rk":"صدوق حسن الحديث","tb":5,"n":18,"d":"136","ns":"الثقفي،الكوفي","iq":"الكوفة","ikh":1,"q":[["ابن حجر العسقلاني","قال في التقريب صدوق اختلط بأخرة وقال مرة صدوق اختلط وقال في هدي الساري من مشاهير الرواة الثقات إلا أنه اختلط فضعفوه بسبب ذلك وتحصل لي من مجموع كلام الأئمة أن رواية شعبة وسفيان الثوري وزهير بن معاوية وزائدة وأيوب وحماد بن زيد عنه قبل الاختلاط وأن جميع من روى عنه غير هؤلاء فحديثه ضعيف لأنه بعد اختلاطه إلا حماد بن سلمة فاختلف قولهم فيه له في البخاري حديث واحد مقرون"],["الذهبي","أحد الأعلام على لين فيه ثقة ساء حفظه بآخره"],["يحيى بن معين","اختلط لا يحتج بحديثه ومرة فمن سمع منه قديما فهو صحيح ومرة ما سمعت أحدا من الناس يقول شيئا في حديثه القديم ومرة سئل أيما أحب إليك يزيد بن أبي زياد أو عطاء بن السائب فقال ما أقربهما ومرة ثقة وما سمع منه جرير ليس من صحيح حديثه وسمع منه أبو عونة في الصحة والاختلاط فلا يحتج بحديثه"],["أحمد بن حنبل","ثقة رجل صالح ومرة من سمع منه قديما فسماعه صحيح ومن سمع منه حديثا لم يكن شيئا وشعبة وثفيان ممن سمع منه قديما وجرير وخالد بن عبد الله وإسماعيل بن علية ممن سمع منه حديثا ومرة لم يسمع من عبيدة شيئا"],["علي بن المديني","كان يتوهم ومرة كان قد ذهب أمره يعني اختلط"],["أبو حاتم الرازي","محله الصدق صالح مستقيم الحديث قبل أن يختلط ثم تغير بآخره سمع منه حماد بن زيد قبل أن يتغير"],["أبو زرعة الرازي","ذكره في أسامي الضعفاء"],["البخاري","أحاديثه القديمة صحيحة ومرة ذكره في الأوسط وقال كنيته أبو زيد"],["أحمد بن شعيب النسائي","كان قد اختلط وأثبت الناس فيه سفيان الثوري وشعبة بن الحجاج ورواية حماد بن زيد عنه جيدة"],["الدارقطني","اختلط ومرة تغير ولا يحتج بحديثه إلا القديم"],["أحمد بن عبد الله العجلي","ثقة ومرة جائز الحديث إلا أنه كان يلقن بآخره ومرة اختلط عطاء بأخرة فمن سمع منه حال اختلاطه فهو مضطرب الحديث"],["أبو حاتم بن حبان البستي","ذكره في الثقات وقال كان قد اختلط بآخره ولم يفحش خطاءه حتى يستحق أن يعدل به عن مسلك العدول بعد تقدم صحة ثباته في الروايات"],["محمد بن سعد كاتب الواقدي","ثقة تغير حفظه بآخره واختلط"],["أبو أحمد بن عدي الجرجاني","اختلط في آخرعمره من سمع منه قديما مثل الثوري وشعبة فحديثه مستقيم ومن سمع منه بعد الاختلاط فأحاديثه فيها بعض النكرة"],["أيوب بن أبي تميمة السختياني","ثقة"],["شعبة بن الحجاج بن الورد","كان نسيا ومرة إذا حدث عن رجل واحد فهو ثقة وإذا جمع بين اثنين فاتقه ومرة من رجاله عن زاذان وميسرة وأبي البختري فلا تكتبه وما حدثك من رجاله عن رجل بعينه فاكتبه"],["الوضاح بن عبد الله اليشكري","كتبت عنه قبل وبعد فاختلط علي"],["يحيى بن سعيد القطان","تغير حفظه ومرة ما سمعت أحدا من الناس يقول في عطاء بن السائب شيئا في حديثه القديم قيل ليحيى ما حدث سفيان وشعبة أصحيح هو قال نعم الا حديثين كان شعبة سمعهما بأخرة ومرة سمع حماد بن زيد من عطاء قبل اختلاطه"],["الحسن بن الصباح البزار","ثقة مشهور ولكنه كان قد تغير فاضطرب في حديثه"],["يعقوب بن سفيان الفسوي","ثقة حجة تغير بآخره"],["أبو عوانة الإسفراييني","سمعت منه قبل وبعد فقيل له تفصل بينهما قال لا"],["أبو جعفر الطحاوي","ذكره في مشكل الآثار وقال تغير بآخرة وقال مرة وإنما حديث عطاء الذي كان منه قبل تغيره يؤخذ من أربعة لا من سواهم شعبة وسفيان الثوري وحماد بن سلمة وحماد بن زيد"],["أبو جعفر العقيلي","يقال إنه تغير بآخرة"],["أبو عبد الله الحاكم","تغير بآخره ومرة تركوه"],["الهيثمي","ثقة ولكنه اختلط"],["ابن الكيال الشافعي","ذكره في الكواكب النيرات في معرفة من اختلط من الرواة الثقات وقال أحد الأعلام علي لين فيه"],["زكريا بن يحيى الساجي","صدوق ثقة لم يتكلم الناس في حديثه القديم"],["شعيب الأرناؤوط","روى عنه جرير بن عبد الحميد بعد الاختلاط"]],"qn":28,"