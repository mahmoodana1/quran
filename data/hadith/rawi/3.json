{"6659":{"s":"مالك بن أنس الأصبحي","f":"مالك بن أنس بن مالك بن أبي عامر بن عمرو","k":2,"rk":"رأس المتقنين وكبير المتثبتين","tb":7,"n":1238,"b":"89","d":"179","age":"90","pr":"الفقيه","ns":"القرشي،التيمي،الحميري،الأصبحي،المدني","iq":"المدينة","dp":"المدينة","q":[["ابن حجر العسقلاني","قال في التقريب إمام دار الهجرة رأس المتقنين وكبير المتثبتين"],["الذهبي","الإمام وقال في التذهيب أحد أعلام الإسلام وإمام ادار الهجرة"],["يحيى بن معين","ثقة ومرة كل من روى عنه مالك بن أنس فهو ثقة إلا عبد الكريم البصرى أبو أمية ومرة حجة ومرة اثبت أصحاب الزهرى مالك ومالك في نافع اثبت عندي من عبيد الله بن عمر ومن أيوب السختياني وفي رواية ابن محرز مالك أوثق من روى عن الزهري من أصحاب الزهري ليس فيمن روى عن الزهري أوثق من مالك"],["أحمد بن حنبل","مالك أثبت في كل شيء ومرة حديثه صحيح ورأيه ضعيف"],["علي بن المديني","أمير المؤمنين في الحديث"],["أبو حاتم الرازي","مالك ثقة إمام أهل الحجاز ومرة ثقة وهو أثبت أصحاب الزهري وابن عيينة وإذا خالفوا مالكا من أهل الحجاز حكم لمالك ومالك نقي الرجال نقي الحديث وهو أنقى حديثا من الثوري والأوزاعي وأقوى في الزهري من ابن عيينة وأقل خطأ منه وأقوى من معمر وابن أبي ذئب"],["البخاري","أصح الأسانيد مالك عن نافع عن ابن عمر"],["أحمد بن شعيب النسائي","ما عندي بعد التابعين أنبل من مالك ولا أجل منه ولا أوثق ولا آمن علي الحديث منه ولا أقل رواية عن الضعفاء"],["الدارقطني","حافظ ومرة يسقط اسم الضعيف عنده في الإسناد ومرة من عادته أن يرسل أحاديث ومرة ذكره في كتاب السنن وقال من الثقات"],["أبو حاتم بن حبان البستي","ذكره في الثقات وقال أول من انتقى الرجال من الفقهاء ومرة من سادات أتباع التابعين وجلة الفقهاء والصالحين"],["محمد بن سعد كاتب الواقدي","ثقة مأمون ثبت ورع فقيه عالم حجة"],["شعبة بن الحجاج بن الورد","قدم المدينة بعد وفاة نافع بسنة ولمالك يومئذ حلقة"],["وهيب بن خالد","كان لا يعدل بمالك أحدا ومرة ما بين شرقها وغربها أحد آمن عندنا على ذلك من مالك وللعرض على مالك أحب إلي من السماع من غيره"],["وكيع بن الجراح","الثبت"],["سفيان بن عيينة","ما كان أشد انتقاء مالك للرجال وأعلمه بشأنهم ومرة كان مالك إماما في الحديث"],["عبد الرحمن بن مهدي","كان لا يقدم علي مالك أحدا"],["يحيى بن سعيد القطان","ما في القوم أصلح حديثا من مالك يعني بالقوم سفيان الثوري وابن عيينة وقال مرة مالك أحب إلي من معمر مرة إمام في الحديث ومرة أمير المؤمنين في الحديث"],["محمد بن إدريس الشافعي","إذا جاء الأثر فمالك النجم ومالك وابن عيينة القرينان وقال مرة مالك حجة الله تعالي علي خلقه بعد التابعين"],["محمد بن عبد الله بن نمير","ما أحد قاس قوله في الرجال غير مالك بن أنس كان لا يحدث عمن لم يكن عنده ولا يحدث عمن ليس هو عنده صاحب حديث"],["عمرو بن علي الفلاس","أثبت من روى عن الزهري ممن لا يختلف فيه"],["أبو داود السجستاني","ليس في الدنيا أحسن حديثا منه على القلة"],["أبو جعفر الطحاوي","ذكره في مشكل الآثار وقال إمام حافظ ثبت في روايته"],["أبو عبد الله الحاكم","ذكره في معرفة علوم الحديث وقال إمام يجمع حديثه"],["أبو بكر البيهقي","ذكره في السنن الكبرى وقال ثقة"],["ابن دحية الكلبي","أمين حديث رسول الله عند جماعة أهل العلم الثقة المأمون في دينه وورعة("]],"qn":25,"te":[[7272,"محمد بن شهاب الزهري",352,2],[7863,"نافع مولى ابن عمر",233,2],[4798,"عبد الله بن ذكوان القرشي",106,2],[8055,"هشام بن عروة الأسدي",63,2],[3122,"زيد بن أسلم القرشي",63,3],[952,"إسحاق بن عبد الله الأنصاري",63,2],[4632,"عبد الله بن أبي بكر الأنصاري",51,2],[4797,"عبد الله بن دينار القرشي",46,3]],"ten":77,"st":[[5085,"عبد الله بن مسلمة الحارثي",410,3],[5175,"عبد الله بن يوسف الكلاعي",291,2],[8350,"يحيى بن يحيى النيسابوري",244,2],[1040,"إسماعيل بن أبي أويس الأصبحي",172,5],[6460,"قتيبة بن سعيد الثقفي",73,2],[5147,"عبد الله بن وهب القرشي",57,2],[7643,"معن بن عيسى القزاز",28,2],[2201,"جويرية بن أسماء الضبعي",25,3]],"stn":44},"5699":{"s":"عكرمة بن خالد المخزومي","f":"عكرمة بن خالد بن العاص بن هشام بن المغيرة بن عبد الله بن عمر ابن مخزوم","k":3,"rk":"ثقة","tb":3,"n":7,"ns":"القرشي،المخزومي،المكي","iq":"مكة","dp":"مكة","q":[["ابن حجر العسقلاني","قال في التقريب ثقة"],["يحيى بن معين","ثقة"],["أحمد بن حنبل","ثقة لم يسمع من ابن عباس وعمر"],["أبو زرعة الرازي","ثقة"],["البخاري","وثقه"],["أحمد بن شعيب النسائي","ثقة"],["أبو حاتم بن حبان البستي","ذكره في الثقات"],["محمد بن سعد كاتب الواقدي","ثقة"]],"qn":8,"te":[[4967,"عبد الله بن عمر العدوي",6,1],[4883